# ---------------------------------------------------------------------------
# ai-token-minimiser configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# The proxy listens here.
PORT=8787
HOST=127.0.0.1

# Upstream provider: "openai" | "github-models" | "custom"
UPSTREAM=openai

# Base URL of the upstream provider (override for Azure / self-hosted / gateways).
#   openai         -> https://api.openai.com/v1
#   github-models  -> https://models.github.ai/inference
UPSTREAM_BASE_URL=https://api.openai.com/v1

# API key for the upstream provider.
# For OpenAI: your OpenAI API key.
# For GitHub Models / Copilot: a GitHub token with the models scope.
# Leave blank to require callers to pass their own Authorization header through.
UPSTREAM_API_KEY=

# Optional shared secret. If set, callers must send this as their Bearer token
# (Authorization: Bearer <PROXY_API_KEY>). Protects your local proxy.
PROXY_API_KEY=

# --- Minimisation strategy toggles ---------------------------------------
# Aggressiveness preset: "off" | "safe" | "balanced" | "aggressive"
MINIMISE_PRESET=balanced

# Maximum tokens of conversation history to keep (system messages always kept).
# 0 disables history trimming.
HISTORY_TOKEN_BUDGET=6000

# Collapse redundant whitespace / blank lines in message content.
STRIP_WHITESPACE=true

# Deduplicate identical message blocks within a single request.
DEDUPE_MESSAGES=true

# Cache identical (deterministic) requests to skip upstream calls entirely.
RESPONSE_CACHE=true
RESPONSE_CACHE_TTL_SECONDS=3600
RESPONSE_CACHE_MAX_ENTRIES=500

# Log level: "silent" | "error" | "info" | "debug"
LOG_LEVEL=info
